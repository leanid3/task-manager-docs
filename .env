#ENV Для конифгурации приложений

# Postgres общие настройки
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Postgres Task Manager
TASK_MANAGER_POSTGRES_DB=task_manager
TASK_MANAGER_POSTGRES_PORT=5443 #внешний порт
TASK_MANAGER_POSTGRES_HOST=task-manager-database
TASK_MANAGER_DATABASE_URL= postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${TASK_MANAGER_POSTGRES_HOST}:5432/${TASK_MANAGER_POSTGRES_DB}?sslmode=disable
# Postgres LLM Worker
LLM_WORKER_POSTGRES_DB=llm_worker
LLM_WORKER_POSTGRES_PORT=5444
LLM_WORKER_POSTGRES_HOST=llm-worker-database
LLM_WORKER_DATABASE_URL= postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${LLM_WORKER_POSTGRES_HOST}:5432/${LLM_WORKER_POSTGRES_DB}?sslmode=disable


# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka
KAFKA_BROKER_ID=1
KAFKA_EXTERNAL_PORT=9092
KAFKA_OFFSETS_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS=true

# Kafka UI
KAFKA_UI_PORT=9100
KAFKA_CLUSTER_NAME=platform

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DOCUMENT_FLOW_MINIO_BUCKET=documents

# Services ports
TASK_MANAGER_HTTP_PORT=8080
TASK_MANAGER_METRICS_PORT=9090
ADMINER_PORT=9099
DOZZLE_PORT=8888
