#ENV Для конифгурации приложений

# Postgres общие настройки
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Postgres Task Manager
POSTGRES_TASK_MANAGER_DB=task_manager
POSTGRES_TASK_MANAGER_PORT=5443

# Postgres LLM Worker
POSTGRES_LLM_WORKER_DB=llm_worker
POSTGRES_LLM_WORKER_PORT=5444

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka
KAFKA_BROKER_ID=1
KAFKA_EXTERNAL_PORT=9092
KAFKA_OFFSETS_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS=true

# Kafka UI
KAFKA_UI_PORT=9100
KAFKA_CLUSTER_NAME=document-flow

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=documents

# Services ports
TASK_MANAGER_HTTP_PORT=8080
TASK_MANAGER_METRICS_PORT=9090
ADMINER_PORT=9099
DOZZLE_PORT=8888
