# Logger
LOGGER_LEVEL=debug
LOGGER_FORMAT=json
LOGGER_APP_PATH=/app/logs/app.log
LOGGER_HEALTH_PATH=/app/logs/health.log
LOGGER_HTTP_PATH=/app/logs/http.log
LOGGER_KAFKA_PATH=/app/logs/kafka.log
LOGGER_MINIO_PATH=/app/logs/minio.log
LOGGER_TASK_PATH=/app/logs/task.log
LOGGER_S3_PATH=/app/logs/s3.log
LOGGER_MAX_SIZE=10
LOGGER_MAX_FILES=5
LOGGER_CLEAR_ON_START=true
LOGGER_MODE=stdout

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_PREFORK=false
SERVER_TIMEOUT=30s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=5s

# Database
DATABASE_HOST=task-manager-database
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=task_manager
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Broker
BROKER_BOOTSTRAP_SERVICE=kafka:29092
BROKER_CLIENT_ID=task_manager_1_client
BROKER_TOPICS=tasks_llm
BROKER_PRODUCER_ACKS=-1
BROKER_PRODUCER_IDEMPOTENCE=true
BROKER_PRODUCER_COMPRESSION=snappy
BROKER_PRODUCER_RETRIES=3
BROKER_PRODUCER_BATCH_SIZE=16384
BROKER_PRODUCER_LINGER_MS=10
BROKER_PRODUCER_MAX_FLIGHT_REQUESTS=5
BROKER_PRODUCER_TIMEOUT_MS=30000
BROKER_CONSUMER_GROUP_ID=task_llm_group
BROKER_CONSUMER_AUTO_COMMIT=true
BROKER_CONSUMER_COMMIT_INTERVAL_MS=5000
BROKER_CONSUMER_SESSION_TIMEOUT_MS=30000
BROKER_CONSUMER_HEARTBEAT_INTERVAL_MS=10000
BROKER_CONSUMER_MAX_POLL_RECORDS=500
BROKER_SECURITY_PROTOCOL=PLAINTEXT
BROKER_SASL_MECHANISM=
BROKER_SASL_USERNAME=
BROKER_SASL_PASSWORD=
BROKER_SSL_CERTIFICATE_VERIFICATION=false

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_HOST=0.0.0.0
METRICS_PATH=/metrics

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_PREFIX=uploads
MINIO_USESSL=false
MINIO_REGION=us-east-1
MINIO_TIMEOUT=30s

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/swagger
